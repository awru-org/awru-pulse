model User {
    id                 String     @id @default(cuid())
    email              String     @unique
    name               String
    refreshToken       String?
    avatar             String?
    googleRefreshToken String?
    telegramChatId     String?
    createdAt          DateTime   @default(now())
    updatedAt          DateTime   @updatedAt
    emailLogs          EmailLog[]
}
